{{page-title "👸 Miss France Unprepared 2026"}}

{{!-- The following component displays Ember's default welcome message. --}}
{{!-- Feel free to remove this! --}}

  <header>
    <h1><LinkTo @route="index">👸 <span title="Miss France Uprising">MFU</span> 2026</LinkTo></h1>
    {{#if this.auth.isAuthenticated}}
      <LinkTo rel="profile" @route="profile" class="profile" title="Profil du juge">
        {{#if this.auth.isExpired}}
          <small class="warning">!</small>
        {{/if}}
        <JudgeAvatar @judge={{this.profile}} role="link" class="profile-picture" alt="Aller vers la page de profil" />
      </LinkTo>
    {{/if}}
  </header>
  <main>
<div class={{this.routeStyleNamespaceClassSet}}>
    {{outlet}}
</div>
  </main>
  <footer>
    Made with 💜 by floby
  </footer>
